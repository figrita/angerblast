{
  "_meta_comment": "Krea2 masked inpaint: repaint only the masked region of an uploaded init image, conditioned on its surroundings. Used to heal texture seams and paint transition bands between background tile variants. Placeholders filled by gen_backgrounds.py.",
  "10": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Krea 2 Turbo" },
    "inputs": { "unet_name": "krea2_turbo_fp8_scaled.safetensors", "weight_dtype": "default" }
  },
  "11": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load Qwen3-VL text encoder (krea2)" },
    "inputs": { "clip_name": "qwen3vl_4b_fp8_scaled.safetensors", "type": "krea2", "device": "default" }
  },
  "12": {
    "class_type": "VAELoader",
    "_meta": { "title": "Load Qwen Image VAE" },
    "inputs": { "vae_name": "qwen_image_vae.safetensors" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Prompt" },
    "inputs": { "text": "{PROMPT}", "clip": ["11", 0] }
  },
  "13": {
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "Negative (zeroed)" },
    "inputs": { "conditioning": ["6", 0] }
  },
  "40": {
    "class_type": "LoadImage",
    "_meta": { "title": "Init image" },
    "inputs": { "image": "{INIT}" }
  },
  "41": {
    "class_type": "LoadImage",
    "_meta": { "title": "Mask image (white = repaint)" },
    "inputs": { "image": "{MASK}" }
  },
  "42": {
    "class_type": "ImageToMask",
    "_meta": { "title": "Mask from red channel" },
    "inputs": { "image": ["41", 0], "channel": "red" }
  },
  "43": {
    "class_type": "VAEEncode",
    "_meta": { "title": "Encode init" },
    "inputs": { "pixels": ["40", 0], "vae": ["12", 0] }
  },
  "44": {
    "class_type": "SetLatentNoiseMask",
    "_meta": { "title": "Restrict denoise to mask" },
    "inputs": { "samples": ["43", 0], "mask": ["42", 0] }
  },
  "3": {
    "class_type": "KSampler",
    "_meta": { "title": "Krea2 turbo masked repaint" },
    "inputs": {
      "seed": "{SEED}",
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": "{DENOISE}",
      "model": ["10", 0],
      "positive": ["6", 0],
      "negative": ["13", 0],
      "latent_image": ["44", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode" },
    "inputs": { "samples": ["3", 0], "vae": ["12", 0] }
  },
  "30": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save result" },
    "inputs": { "filename_prefix": "{PREFIX}", "images": ["8", 0] }
  }
}
