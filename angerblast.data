# formations.toml - the spawn director's formation SHAPES. The shape geometry (row/vee/
# stream/grid/swarm) stays a C primitive; these numbers drive its counts, spacing, per-stage
# scaling and caps. A biome's [director].formations list chooses WHICH of these it spawns.
# Order matters: index = formation op id (0=row 1=vee 2=stream 3=grid 4=swarm).
#
# Slot meaning per shape (see spawn.c spawn_formation):
#   row    : count, count_per_stage, count_max, rows, margin, row_gap
#   vee    : per, per_per_stage, per_max, dx_step, y_top_step, y_anchor_step
#   stream : lanes, lanes_div(stage/div), lanes_max, count, count_max, y_step
#   grid   : cols, cols_div(stage/div), cols_max, rows, margin, row_gap
#   swarm  : count, count_per_stage, count_max

formation = [
  { op="row",    count=10, count_per_stage=1, count_max=18, rows=2, margin=80, row_gap=40 },
  { op="vee",    per=6,  per_per_stage=1, per_max=11, dx_step=36, y_top_step=26, y_anchor_step=22 },
  { op="stream", lanes=2, lanes_div=2, lanes_max=3, count=10, count_max=20, y_step=30 },
  { op="grid",   cols=7, cols_div=2, cols_max=11, rows=4, margin=80, row_gap=40 },
  { op="swarm",  count=18, count_per_stage=3, count_max=55 },
]
# palette.toml - the 64-colour palette (row-major, 8x8). `colors` is indexed 0..63.
# `names` maps a semantic name -> palette index, used by other files (color = "coral").

colors = [
  "000000","12173d","293268","464b8c","6b74b2","909edd","c1d9f2","ffffff",
  "a293c4","7b6aa5","53427f","3c2c68","431e66","5d2f8c","854cbf","b483ef",
  "8cff9b","42bc7f","22896e","14665b","0f4a4c","0a2a33","1d1a59","322d89",
  "354ab2","3e83d1","50b9eb","8cdaff","53a1ad","3b768f","21526b","163755",
  "008782","00aaa5","27d3cb","78fae6","cdc599","988f64","5c5d41","353f23",
  "919b45","afd370","ffe091","ffaa6e","ff695a","b23c40","ff6675","dd3745",
  "a52639","721c2f","b22e69","e54286","ff6eaf","ffa5d5","ffd3ad","cc817a",
  "895654","61393b","3f1f3c","723352","994c69","c37289","f29faa","ffccd0",
]

# semantic names, in index order (position in this list = palette index 0..63), so other
# TOML files can write e.g. color = "coral".
names = [
  "black","ink","navy","indigo","periwinkle","lilac","ice","white",
  "mauve","plum","grape","aubergine","deeppurple","violet","orchid","lavender",
  "mint","seagreen","pine","tealdk","tealddk","abyss","midblue","blueviolet",
  "azure","sky","cyan","palecyan","teal","steel","deepteal","nightteal",
  "aqua","aquabrt","turquoise","aqualt","khaki","olive","olivedk","oliveddk",
  "lime","leaf","gold","peach","coral","red","pinkred","crimson",
  "bloodcrimson","blood","wine","magenta","hotpink","pink","pinklt","skin",
  "clay","brown","umber","plumdk","mauvedk","rose","blush","blushlt",
]
# runes.toml - the 5 socketable runes, in order (RED, BLUE, GREEN, YELLOW, PURPLE).
# Each rune's stat effect is hardcoded in weapon_stats (engine), but its identity is data.

[[rune]]
name = "Ember"
color = "coral"
sprite = "sprites/common/rune_ember.png"
stat = "+25% damage"

