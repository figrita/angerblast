# Sprayer
name="Starspitter"
sprite="sprites/01_void/starspitter.png"
flavor="Gargles starlight, spits grapeshot."
move="hover"
move_params={ strafe_freq=0.8, strafe_amp=2.0 }
fire="spiral"
fire_params={ count=2, speed_scale=0.85, arc=6.28319, spin=0.28, aimed=false, color="sky" }
hp=24
speed=24
radius=15
fire_interval=0.5
min_stage=5
color="sky"
xp=5
shape=[{op="poly",sides=5,r=1.0,color="body",spin=40},{op="circle",r=0.35,color="white",alpha=0.5}]
# Warden - an ELITE (miniboss). Spawns as a mirrored pair; big, tanky, high XP. Fires the
# composable `splitter` emitter (aimed darts that burst into a ring on death).
name="Rift Warden"
sprite="sprites/01_void/rift_warden.png"
flavor="Keeper of the tear in the sky. It would like it shut, with you inside."
move="hover"
move_params={ strafe_freq=0.6, strafe_amp=1.4 }
fire="aimed"
emitter="splitter"
elite=true
hp=320
speed=22
radius=26
fire_interval=1.3
min_stage=2
color="violet"
xp=40
shape=[{op="poly",sides=8,r=1.0,color="body",spin=20},{op="ring",r=0.72,thick=0.16,color="hotpink",alpha=0.8},{op="poly",sides=8,r=0.5,color="white",alpha=0.4,spin=-30}]
# Breacher - a BEEFY descender that creeps down, then LUNGES at the player when close. Tanky,
# slow, dangerous up close (death_burst). The "creep then pounce" threat. (note: 14_warden is
# the void elite; this is a normal-but-heavy enemy.)
name="Hullripper"
sprite="sprites/01_void/hullripper.png"
flavor="Built to open ships like tins. You are the tin."
move="lunge"
move_params={ creep_mul=0.45, trigger_dist=240, lunge_mul=3.4, lunge_dur=0.5, recover_dur=1.2 }
fire="none"
death_burst=10
hp=46
speed=30
radius=18
fire_interval=0.0
min_stage=2
color="grape"
xp=4
shape=[{op="poly",sides=6,r=1.0,color="body",outline="white"},{op="poly",sides=6,r=0.55,color="violet",alpha=0.8},{op="circle",r=0.25,color="white"}]
# 02_ember - the second biome. Hotter palette, denser swarm, tougher boss. Authored
# entirely as data: this folder + its enemies/, no engine changes.
name = "Ember Reach"

[theme]
bullet_color = "gold"
gem_color = "palecyan"
background = "umber"
star_colors = ["maroon", "wine", "peach"]

[director]
field_cap_base = 80
field_cap_per_stage = 24
field_cap_max = 480
wave_interval_base = 11.0
waves_to_boss = 11
formations = ["stream", "swarm", "vee"]

[boss]
name = "Cinder Tyrant"
weapon = "flame"        # boss yield: fight fire with fire
hp = 900
radius = 52
phases = [
  { hp_above = 0.5, fire = "spread", count = 6 },
  { hp_above = 0.0, fire = "spread", count = 9, plus = "flower" },
]
# Multi-part layout: a head flanked by two hands. The HEAD is shielded (unhittable) until
# BOTH hands are destroyed; killing the head ends the fight. Each part fires its own danmaku.
# (When [[boss.part]] is present the single-body `phases` above are ignored for combat.)
[[boss.part]]
sprite="sprites/02_ember/boss_head.png"
head = true
off_x = 0
off_y = -20
hp = 700
radius = 92
fire = "aimed"
count = 5
interval = 1.1
color = "crimson"
emitter = "spiral_pods"      # once exposed, the head sheds recursive ring-pods

[[boss.part]]
sprite="sprites/02_ember/boss_hand.png"
off_x = -155
off_y = 60
hp = 650
radius = 60
fire = "ring"
count = 10
interval = 1.4
color = "maroon"

[[boss.part]]
sprite="sprites/02_ember/boss_hand.png"
off_x = 155
off_y = 60
hp = 650
radius = 60
fire = "spread"
count = 7
interval = 1.0
color = "maroon"
# Ember - an octagon with a glowing ring (new geometry: ring op + 8-gon)
name="Cinder Wisp"
sprite="sprites/02_ember/cinder_wisp.png"
flavor="A stray spark with delusions of arson."
move="drift"
fire="aimed"
fire_params={ count=1, speed_scale=1.0, aimed=true, color="coral" }
hp=12
speed=30
radius=12
fire_interval=2.0
min_stage=1
color="coral"
xp=2
shape=[{op="poly",sides=8,r=1.0,color="body",spin=20},{op="ring",r=0.75,thick=0.18,color="gold",alpha=0.8},{op="circle",r=0.3,color="white",alpha=0.6}]
# Blaze - a triple-layered counter-spinning star (new geometry: 3 poly layers)
name="Flarecaller"
sprite="sprites/02_ember/flarecaller.png"
flavor="Conducts the firestorm like a choir."
move="hover"
fire="flower"
hp=24
speed=22
radius=16
fire_interval=1.4
min_stage=2
color="peach"
xp=4
shape=[{op="poly",sides=6,r=1.0,color="red",spin=60},{op="poly",sides=6,r=0.7,color="gold",spin=-90,alpha=0.9},{op="circle",r=0.3,color="white"}]
fire_params={ speed_scale=1.25 }
# Pyrelord - an ELITE (miniboss) for the Ember biome. Mirrored pair; fires the composable
# `comet` emitter (slow shots that trail spark bullets), plus a heavy aura.
name="Pyrelord"
sprite="sprites/02_ember/pyrelord.png"
flavor="Nobility of the burning court; its retinue is the fire itself."
move="hover"
move_params={ strafe_freq=0.5, strafe_amp=1.2 }
fire="spread"
emitter="comet"
elite=true
hp=420
speed=20
radius=28
fire_interval=1.1
min_stage=1
color="crimson"
xp=55
shape=[{op="poly",sides=6,r=1.0,color="body",spin=15},{op="ring",r=0.78,thick=0.2,color="gold",alpha=0.85},{op="circle",r=0.35,color="white",alpha=0.6}]
# Shard - a fast diamond with cross spokes (new geometry: line ops)
name="Slagshard"
sprite="sprites/02_ember/slagshard.png"
flavor="Molten shrapnel that never learned to slow down."
move="straight"
fire="none"
hp=6
speed=95
radius=10
fire_interval=0.0
min_stage=1
color="gold"
xp=1
shape=[{op="poly",sides=4,r=1.0,color="body",spin=120},{op="line",x1=-1.0,y1=0.0,x2=1.0,y2=0.0,thick=0.12,color="white"},{op="line",x1=0.0,y1=-1.0,x2=0.0,y2=1.0,thick=0.12,color="white"}]
# Cinderling - a Galaga-style diver: holds, then swoops at the player. A movement/contact
# threat (not a bullet enemy) to balance Ember's bullet-heavy roster.
name="Cinderling"
sprite="sprites/02_ember/cinderling.png"
flavor="Newly kindled and eager to prove it can burn."
move="dive"
move_params={ descend_mul=0.6, hold_time=1.0, dive_mul=1.9 }
fire="none"
hp=14
speed=48
radius=12
fire_interval=0.0
min_stage=1
color="coral"
xp=2
shape=[{op="poly",sides=3,r=1.0,color="body",spin_offset=90},{op="ring",r=0.6,thick=0.16,color="gold",alpha=0.7}]
# Scorcher - a drifting turret that lobs a 3-shot aimed spread at a measured cadence. A
# mid-range bullet threat that pressures the player without flooding (sane 2.2s interval).
name="Charhulk"
sprite="sprites/02_ember/charhulk.png"
flavor="A drifting kiln that never finished cooling."
move="drift"
fire="spread"
fire_params={ count=2, arc=0.5, speed_scale=1.0, aimed=true, color="peach" }
hp=22
speed=18
radius=14
fire_interval=2.6
min_stage=2
color="maroon"
xp=3
shape=[{op="rect",w=2.0,h=2.0,color="body",outline="gold"},{op="circle",r=0.4,color="white",alpha=0.6}]
death_burst=8
# Magmate - a Robotron-style hunter that slowly steers toward the player and fires an
# occasional aimed bolt. A pursuit/positioning threat; low fire volume (1.8s) so it's not a
# bullet-spammer like Blaze â€” it makes you keep moving.
name="Magma Stalker"
sprite="sprites/02_ember/magma_stalker.png"
flavor="Follows the smell of unburned things."
move="hunt"
move_params={ steer=0.035 }
fire="aimed"
fire_params={ count=1, speed_scale=1.1, aimed=true, color="crimson" }
hp=18
speed=36
radius=12
fire_interval=1.8
min_stage=3
color="crimson"
xp=3
shape=[{op="rect",w=2.0,h=0.8,color="body"},{op="rect",w=0.8,h=2.0,color="body"},{op="circle",r=0.4,color="gold",alpha=0.7}]
lunge_every=2.8
# 03_frost - Frost Verge. The third biome: icy palette, swoopers + spiral-descenders +
# lunging beefy enemies, plus harder ICE-tinted remixes of earlier foes. Tougher than ember.
name = "Frost Verge"

[theme]
bullet_color = "crimson"
gem_color = "orchid"
background = "abyss"
star_colors = ["deepteal", "teal", "ice"]

[director]
field_cap_base = 36
field_cap_per_stage = 38
field_cap_max = 640
wave_interval_base = 9.0
waves_to_boss = 12
formations = ["vee", "stream", "grid", "swarm"]

# The Glacial Wyrm is a true WORM boss: the head sweeps a serpentine path across the
# arena and 10 destructible body segments follow its trail. Segments must die before the
# head is vulnerable (standard head-shield rule); bursts ripple down the body.
[boss]
name = "Glacial Wyrm"
weapon = "goo"          # boss yield: cryo-gel (goo slows + primes burns)
kind = "worm"

[boss.worm]
segments = 10
spacing = 36          # px of body between segment centers
speed = 155           # head travel speed
turn_rate = 1.3       # serpentine wander rate
head_hp = 420
head_radius = 34
head_fire = "aimed"
head_count = 4
head_interval = 1.4
head_color = "ice"
head_sprite = "sprites/03_frost/worm_head.png"
segment_hp = 80
segment_radius = 22
segment_fire = "ring"
segment_count = 5
segment_interval = 3.0
segment_color = "deepteal"
segment_sprite = "sprites/03_frost/worm_seg.png"
# Sleet - a SWOOPER: arcs across the screen toward the player while descending. Fast, evasive.
name="Sleetshade"
sprite="sprites/03_frost/sleetshade.png"
flavor="A cold ghost that arrives sideways."
move="swoop"
move_params={ fall_mul=0.9, arc_rate=2.6, arc_amp=3.0 }
fire="none"
death_burst=4
hp=10
speed=52
radius=11
fire_interval=0.0
min_stage=1
color="palecyan"
xp=2
shape=[{op="poly",sides=3,r=1.0,color="body",spin_offset=90},{op="circle",r=0.3,color="white",alpha=0.6}]
# Drillspike - a SPIRAL descender: corkscrews down its axis while firing aimed shots. Hard to
# predict; pressures with both movement and fire.
name="Icebore"
sprite="sprites/03_frost/icebore.png"
flavor="Corkscrews through the floe, and anything softer."
move="spiral"
move_params={ fall_mul=0.7, spin_rate=3.2, radius=80 }
fire="aimed"
fire_params={ count=1, speed_scale=1.0, aimed=true, color="cyan" }
hp=18
speed=30
radius=12
fire_interval=1.6
min_stage=2
color="cyan"
xp=3
shape=[{op="poly",sides=4,r=1.0,color="body",spin=120},{op="poly",sides=4,r=0.5,color="white",alpha=0.5,spin=-120}]
# Rimebeast - a BEEFY lunger: creeps down, pounces hard when close, big death burst. The
# Frost biome's heavy bruiser. Slow but very dangerous up close.
name="Rimebeast"
sprite="sprites/03_frost/rimebeast.png"
flavor="Shaggy with hoarfrost; lunges before it thinks. It never thinks."
move="lunge"
move_params={ creep_mul=0.4, trigger_dist=260, lunge_mul=3.8, lunge_dur=0.55, recover_dur=1.3 }
fire="none"
death_burst=12
hp=60
speed=30
radius=20
fire_interval=0.0
min_stage=3
color="steel"
xp=5
shape=[{op="poly",sides=8,r=1.0,color="body",outline="ice"},{op="poly",sides=8,r=0.55,color="ice",alpha=0.7},{op="circle",r=0.25,color="white"}]
# Hailspinner - a hovering ring-spinner (a sane-cadence Blaze cousin: ~0.7s, not a flood).
name="Hailspinner"
sprite="sprites/03_frost/hailspinner.png"
flavor="A cyclone of hail wound around a bad idea."
move="hover"
move_params={ strafe_freq=0.7, strafe_amp=1.8 }
fire="ring"
fire_params={ count=9, count_per_stage=0, speed_scale=1.0, arc=6.28319, spin=0.35, aimed=false, color="azure" }
hp=22
speed=24
radius=14
fire_interval=2.4
min_stage=2
color="azure"
xp=4
shape=[{op="poly",sides=6,r=1.0,color="body",spin=50},{op="circle",r=0.35,color="white",alpha=0.5}]
# Frost Grunt - an ICE-tinted, beefier remix of the Void Grunt (march). Same behaviour, more
# hp + bigger + cold palette: cheap variety for a later biome.
name="Frosthusk"
sprite="sprites/03_frost/frosthusk.png"
flavor="A marching shell of ice; something old walks inside it."
move="march"
move_params={ step_mul=1.1, edge_margin=40, row_drop=28, settle_speed=7 }
fire="none"
death_burst=4
hp=16
speed=30
radius=13
fire_interval=0.0
min_stage=1
color="ice"
xp=2
shape=[{op="rect",w=2.0,h=2.0,color="body",outline="white"},{op="circle",r=0.35,color="palecyan",alpha=0.6}]
# Glaciator - the Frost ELITE: a mirrored-pair miniboss firing the composable spiral_pods
# emitter. An ice-clad, tankier cousin of the Warden.
name="Glaciator"
sprite="sprites/03_frost/glaciator.png"
flavor="The slow patience of ice, armed."
move="hover"
move_params={ strafe_freq=0.6, strafe_amp=1.4 }
fire="aimed"
emitter="spiral_pods"
elite=true
hp=420
speed=22
radius=28
fire_interval=1.4
min_stage=2
color="midblue"
xp=50
shape=[{op="poly",sides=8,r=1.0,color="body",spin=20},{op="ring",r=0.74,thick=0.16,color="cyan",alpha=0.85},{op="poly",sides=8,r=0.45,color="white",alpha=0.4,spin=-30}]
# Frostworm - a CENTIPEDE: spawns as a 4-segment chain that slithers after the player.
# Shooting out a middle segment SPLITS the worm -- the rear half becomes its own hunter.
# Each popped segment sprays a death burst, so chewing through the body has teeth.
name="Frostworm"
sprite="sprites/03_frost/frostworm.png"
flavor="Cut it in half and now there are two problems."
move="hunt"
move_params={ steer=0.035 }
fire="none"
death_burst=5
chain_length=4
chain_spacing=18
hp=26
speed=55
radius=12
fire_interval=0.0
min_stage=3
color="palecyan"
xp=3
shape=[{op="circle",r=1.0,color="body"},{op="circle",r=0.55,color="ice",alpha=0.8}]
# 04_tempest - Tempest Core. Fourth biome: violent storm palette, dense fast waves, a
# multi-part boss (head + two hands). The hardest of the "elemental" run before the abstract
# worlds. Mixes lunging bruisers, spiral fire, and storm-tinted remixes.
name = "Tempest Core"

[theme]
bullet_color = "crimson"
gem_color = "palecyan"
background = "deeppurple"
star_colors = ["violet", "lavender", "ice"]

[director]
field_cap_base = 40
field_cap_per_stage = 42
field_cap_max = 700
wave_interval_base = 8.0
waves_to_boss = 13
formations = ["stream", "swarm", "vee", "grid"]

[boss]
name = "Storm Sovereign"
weapon = "lightning"    # boss yield: the storm itself
hp = 1600
radius = 56
phases = [
  { hp_above = 0.5, fire = "spread", count = 8 },
  { hp_above = 0.0, fire = "spread", count = 12, plus = "flower" },
]
# head + two hands; head shielded until the hands fall (classic).
[[boss.part]]
sprite="sprites/04_tempest/boss_head.png"
head = true
off_y = -20
hp = 1100
radius = 96
emitter = "spiral_pods"
interval = 1.0
color = "gold"

[[boss.part]]
sprite="sprites/04_tempest/boss_hand.png"
off_x = -156
off_y = 64
hp = 1000
radius = 64
fire = "ring"
count = 12
interval = 1.2
color = "coral"

[[boss.part]]
sprite="sprites/04_tempest/boss_hand.png"
off_x = 156
off_y = 64
hp = 1000
radius = 64
fire = "spiral"
count = 4
interval = 0.9
color = "coral"
# Gust - fast swooper that knifes across the storm. Erratic, evasive, light.
name="Zephyrling"
sprite="sprites/04_tempest/zephyrling.png"
