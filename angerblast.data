lunge_every=2.4
# Spinner
name="Whirling Idol"
sprite="sprites/01_void/whirling_idol.png"
flavor="A heretic shrine that spins itself into a fusillade."
move="hover"
move_params={ strafe_freq=0.8, strafe_amp=2.0 }
fire="ring"
fire_params={ count=8, count_per_stage=0, speed_scale=0.8, arc=6.28319, spin=0.4, aimed=false, color="hotpink" }
hp=16
speed=28
radius=14
fire_interval=2.2
min_stage=2
color="orchid"
xp=3
shape=[{op="poly",sides=5,r=1.0,color="body",spin=40},{op="circle",r=0.35,color="white",alpha=0.5}]
# Orbiter
name="Carrion Moth"
sprite="sprites/01_void/carrion_moth.png"
flavor="Circles dead satellites, then dives at whatever still moves."
move="orbit"
move_params={ orbit_time=2.5, radius=60, ang_rate=2.0, y_scale=0.5, descend_mul=0.3, dive_mul=1.4 }
fire="none"
hp=9
speed=50
radius=11
fire_interval=0.0
min_stage=3
color="peach"
xp=2
shape=[{op="poly",sides=3,r=1.0,color="body",spin_offset=90},{op="circle",r=0.35,color="white",alpha=0.5}]
# Turret
name="Null Sentry"
sprite="sprites/01_void/null_sentry.png"
flavor="A drifting watch-eye that never blinks and never stops firing."
move="drift"
fire="aimed"
fire_params={ count=1, speed_scale=1.0, aimed=true, color="coral" }
hp=20
speed=18
radius=14
fire_interval=2.0
min_stage=3
color="mauve"
xp=3
shape=[{op="rect",w=2.0,h=2.0,color="body",outline="white"},{op="circle",r=0.35,color="white",alpha=0.5}]
# Popcorn
