xp=1
shape=[{op="poly",sides=4,r=1.0,color="body",spin_offset=45},{op="circle",r=0.35,color="white",alpha=0.5}]
# Crab
name="Scuttlemaw"
sprite="sprites/01_void/scuttlemaw.png"
