sprite = "sprites/common/fx_goo.png"
duration = 5.0
stack = "refresh"
max_stacks = 1
dot = false
halts_move = false
halts_fire = false
# emitters.toml - the composable danmaku graph. Each [[emitter]] is a named burst; a bullet
# it spawns can carry a CHILD emitter (referenced BY NAME) that runs on a timer or on death,
# so "bullets that split / trail / burst" are pure data. This is NOT a scripting VM: emitters
# reference each other only by name, the engine walks the graph, and runaway is bounded by a
# depth cap (EMITTER_MAX_DEPTH=4) + the bullet pool. Every child ref is validated at load.
#
# Fields:
#   name            unique name (referenced by enemies/bosses via `emitter=`, and as a child)
#   count / count_per_stage   bullets per burst (+per stage)
#   speed_scale     x the base speed the caller supplies
#   arc             fan span (rad); 6.28319 = full ring
#   spin            rad added to the rotating phase each burst
#   aimed           true = fan centred on the player
#   radius / color  bullet look
#   child           name of the emitter each spawned bullet carries (optional)
#   child_mode      "timer" (fire child every child_interval s) | "death" (fire once on expiry)
#   child_interval  seconds between timer bursts
#   child_speed     base speed handed to the child burst
# NOTE: tomlc99 forbids newlines inside an inline table, so each emitter is one line.

emitter = [
  # a small aimed dart that, on death, bursts into a ring (classic "splitter")
  { name="burst_ring", count=8, arc=6.28319, speed_scale=1.0, radius=5, color="hotpink" },
  { name="splitter",   count=3, arc=0.5, aimed=true, speed_scale=1.1, radius=6, color="coral", child="burst_ring", child_mode="death", child_speed=90 },

  # a slow descending wave that trails little spark bullets as it travels (timer child)
  { name="trail_spark", count=1, arc=0, speed_scale=0.4, radius=3, color="gold" },
  { name="comet",       count=5, arc=2.4, speed_scale=1.0, radius=7, color="peach", child="trail_spark", child_mode="timer", child_interval=0.12, child_speed=60 },

  # a rotating spiral whose arms themselves shed a ring on death (two-level recursion)
  { name="mini_ring",   count=8, arc=6.28319, speed_scale=0.9, radius=4, color="sky" },
  { name="spiral_pods", count=3, arc=6.28319, spin=0.3, speed_scale=0.9, radius=6, color="azure", child="mini_ring", child_mode="death", child_speed=80 },
]
# events.toml - named set-piece waves, layered over the random spawner at FIXED wave
# indices so the rhythm is learnable (wave_index = wavesThisStage when it fires, 0-based).
# Announced with a slam banner + stinger 1.5s before spawning. Spawn geometry per `kind`
# is a C primitive in spawn.c (spawn_event); these numbers tune it. F5 hot-reloads.
#
#   kind  : wall (full-width phalanx, slow descent) | pincer (columns from both side
#           edges) | ambush (swarm boils up from the BOTTOM) | storm (staggered elites)
#           | slalom (secret bonus-target chain: shoot ALL -> weapon crate) | lasers
#           (dodge-only sweeping beam gauntlet; count = number of beams)
#   enemy : random | elite | beefy (highest-hp stage-valid type)
#   hp_mul / size_mul / speed_mul multiply the spawned enemies' stats.
#   chance: arming roll, default 1. <1 makes the event feel RANDOM (a failed roll is
#           just a normal wave) -- the slalom uses this so the secret can't be farmed.

[[event]]
name = "the_wall"
banner = "THE WALL"
sub = "BREAK THROUGH"
kind = "wall"
enemy = "beefy"
count = 12
hp_mul = 3.0
size_mul = 1.35
speed_mul = 0.55
min_stage = 2
wave_index = 5

[[event]]
name = "pincer"
banner = "PINCER"
sub = "BOTH FLANKS"
kind = "pincer"
enemy = "random"
count = 10
hp_mul = 1.2
size_mul = 1.0
speed_mul = 1.1
min_stage = 3
wave_index = 8

[[event]]
name = "ambush"
banner = "AMBUSH"
sub = "BEHIND YOU"
kind = "ambush"
enemy = "random"
count = 14
hp_mul = 0.8
size_mul = 0.9
speed_mul = 1.3
min_stage = 4
wave_index = 3

[[event]]
name = "elite_storm"
banner = "ELITE STORM"
sub = "HOLD THE LINE"
kind = "storm"
enemy = "elite"
count = 3
hp_mul = 1.0
size_mul = 1.0
speed_mul = 1.0
min_stage = 5
wave_index = 9

# the SECRET: a chain of gold drones slaloms across -- shoot EVERY one before it
# escapes and a weapon crate falls (catch it, it doesn't magnetize). Random, not
# scheduled: most stages it simply never appears.
[[event]]
name = "slalom"
banner = "BONUS TARGETS"
sub = "SHOOT THEM ALL"
kind = "slalom"
enemy = "random"
count = 6
hp_mul = 0.6
size_mul = 1.0
speed_mul = 1.0
min_stage = 2
wave_index = 4
chance = 0.4

# dodge-only palette cleanser: sweeping laser walls with one narrow gap each.
# DPS is irrelevant -- pure positioning. Waves hold until the gauntlet ends.
[[event]]
name = "laser_gauntlet"
banner = "LASER GRID"
sub = "THREAD THE GAP"
kind = "lasers"
enemy = "random"
count = 6
hp_mul = 1.0
size_mul = 1.0
speed_mul = 1.0
min_stage = 2
wave_index = 7
chance = 0.65
# evolutions.toml - the weapon x trifecta evolution matrix.
# [mods.<trifecta>] = the shared stat/behaviour preset for that trifecta column.
# [[row]] per weapon (WeaponId order) = 12 {name, desc} for that weapon's evolutions.
# special: none explode beam swarm rapid pierceall burn shotgun rail storm voidpull prism chaos
# on_kill: none magnet chain shield bounty frag reignite
# on_hit_effect/aura_effect: none slow burn poison freeze shock weaken mark goo

[mods.inferno]
damage_mul = 2.18
rate_mul = 0.95
size_mul = 1.3
multi_add = 0
pierce_add = 1
special = "explode"
on_hit_effect = "none"
on_hit_mag = 0
on_kill = "chain"
aura_effect = "none"

[mods.stream]
damage_mul = 1.95
