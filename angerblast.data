©E³†3/ğW‚p;TËceÃÓ CãÛu␀␀Ã÷ûîü®v_Ó3XÇahğ-$–¦Îd§áàF:É¾b·ôÃôÊ[W~wy½a(	@>İE´‘Ÿ”EÖHa␀éøxµŠ¶³y¦:9øûòqDÜ²»hÃÅ ?½¸“2IÇyõ¥§-Ş$Š
ü¤v^ŒÖ‹äQ—À¹˜¿´ÚÓÙtn`]²ä˜pËj‹ÈNÖ‡2—NËyøÜ8ÚØu÷Fú¹9™È‰°ˆ›, Ç…:…i7­Š¨s]_ĞUèâsJw|G\«TğLñƒ§|_…Ú í_5Ö= DT“T£ÉQ­Ş 6ÁÛôÄ<†¯&/A˜O¡µ(%Ù€)‚æJ­ƒŞ½AxEx,L„ÌQ"Ò®6lzn` Bx¿P7Ke[<úü~ÑV1nÅ³píuúó-ùÿ&Î4”²X—`␀␀␀␀IEND®B`‚# balance.toml - all gameplay tuning. Edit and relaunch (or press F5 to hot-reload).
# Every value here was a #define in balance.h; now it's loaded at runtime.

[player]
radius        = 11.0
shield_max    = 35.0   # 50 -> 70: more effective HP stretches every run ~longer toward the
                       # 15-25 min target band WITHOUT changing the difficulty-curve shape
shield_delay  = 1.8    # recover sooner between hits (eases early; late hits outpace it anyway)
shield_rate   = 10.0
shield_hit    = 5.0    # shield drained per hit (~14 hits to break a full 70). Higher = each little
                       # blast hurts more (was an implicit 1 = a near-free 70-hit sponge). Paired
                       # with shield-refill-on-hull-hit, each of the 4 hearts is a fresh 14-hit buffer.
armor_k       = 100.0  # Armor Plating DR half-point. reduction = armor/(armor+armor_k), so each
                       # +20 armor stack gives DIMINISHING returns: 1 stack ~17%, 2 ~29%, 3 ~37%,
                       # 5 ~50%. Never reaches 100%. Lower armor_k = each point of armor worth more.
hp            = 4       # hull pips; a hull hit refills shield to full (a fresh buffer each heart)
move_speed    = 320.0
pickup_radius = 90.0
fire_interval = 0.14
bullet_damage = 6.0
bullet_speed  = 620.0
iframe        = 1.3
accel         = 2600.0
friction      = 0.84
# drift (Shift / pad triggers L2/R2): hop, steer-opposite, soak bullets to charge
dodge_cooldown = 0.9     # seconds before you can drift again
# drift = powerslide + charge (Mario Kart): a subtle HOP kicks you sideways ("immediate shift"),
# then you COAST along your ORIGINAL heading at ~normal speed while HOLDING the stick opposite the
# slide to sustain it (that hold is the counter-steer). Up/down lightly NUDGES the path's Y. The
# whole slide charges the weapon even while auto-firing; releasing rips the mini-turbo. Absorbed
# bullets are harmless and add bonus charge. Drift == charge.
drift_hop_speed     = 600.0   # sideways KICK off the hop (the snappy "immediate shift" pop)
drift_speed         = 350.0   # coast speed along the locked heading (~move_speed 320, a hair faster)
drift_trim_cone     = 0.45    # max path bend (rad, ~26Â°) the up/down trim can add off the locked heading
drift_turn_rate     = 6.0     # how responsively the trim eases toward the stick (per second)
drift_grip          = 4.0     # velocity easing toward the drift heading (low = slidey inertia, momentum carries)
drift_bullet_range  = 40.0    # extra absorption radius beyond the ship's collision circle
drift_charge_per_bullet = 0.10  # bonus charge seconds per absorbed bullet (grind reward, on top of time)
drift_max_time      = 2.5     # hard cap on one slide (s) â€” normally ended by wall / release / letting go of opposite
drift_lean_grace    = 0.35    # startup grace (s) before you must hold opposite to sustain (time to shift the stick)
drift_yaw_deg       = 22.0    # base counter-steer yaw (deg): nose tilts opposite the slide
drift_yaw_arc_deg   = 14.0    # extra yaw when leaning hard opposite (more hold = more counter-steer)
drift_charge_rate   = 1.15    # charge-seconds gained per real second drifting (LV1 ~0.5s, full ~1.3s)
drift_arc_charge_bonus = 0.25 # extra charge-rate per radian of steer â€” skillful drifts charge faster

# active-weapon loadout (Mega Man X model): ONE weapon fires at a time (Q/E/1-3/L1/R1
# to switch), so the fired weapon earns a focus multiplier over the old all-fire tuning.
# Firing a CHARGED shot opens the vent window: no firing/charging until it clears.
active_focus   = 1.9     # damage mult on the active weapon (drones excluded)
vent_lv1       = 0.55    # post-charged-shot lockout, quick (LV1) release
vent_full      = 0.9     # post-charged-shot lockout, full (LV2) release

[enemy_scaling]
# Tougher enemies, with the LATE game scaling harder so a skilled pilot dies ~15-25 min in
# (close, on-the-ropes) instead of becoming immortal. hp_quadratic + bullet density/speed per
# stage are the late-game levers (they dominate at high stage); linear/base keep early game sane.
# PRINCIPLE: base values keep EARLY game survivable; per_stage / quadratic terms carry the
# LATE ramp so a skilled pilot dies ~15-25 min in. Don't inflate base (it walls stage 1-2).
hp_linear       = 0.44    # * stage
hp_quadratic    = 0.075   # * stage^2  â€” raised twice (chest era, then power caps): with the
                          # build's ceiling bounded, the mid-game curve can finally be MEAN.
                          # stage 4 â‰ˆ x3.9, stage 6 â‰ˆ x6.3 before horde/loop multipliers
speed_per_stage = 0.06    # * stage
enemy_speed_mul = 1.30    # global enemy MOVE speed â€” swarm advances, but 1.5 was too relentless
                          # once the aggressive lunge/swoop roster was added (walled stage ~4).
bullet_base     = 75.0    # 112 -> 85: slower enemy bullets, bigger dodge windows (less "sniper")
bullet_per_stage = 9.0     # the per-stage ramp still climbs from the lower base
elite_hp_per_loop = 0.35   # elites gain +35% max hp per full biome-loop clear (loopCount 0 = none)
# LOOP PRESSURE: the stage curves are polynomial but a snowballed build grows exponentially,
# so long games flatlined ("100% invincible once i loop"). These compound per full loop and
# keep the late game honest without touching the first pass at all (loopCount 0 = no effect).
# Used to be split against a second "horde matching" system keyed to player level+evolutions
# (reacting to the BUILD, not the run) -- folded in here so there's one loopCount-driven curve
# per stat instead of two systems stacking on each other.
loop_hp_mul       = 2.0    # every enemy's hp x2.0 per loop (compounding; was 1.7, absorbed the
                           # old per-build horde_hp bonus so total toughness lands about the same)
loop_fire_mul     = 0.85   # enemy fire interval x0.85 per loop (compounding; faster volleys)
loop_bullet_speed = 0.15   # enemy bullet speed +15% per loop
loop_speed_mul    = 0.036  # enemy MOVE speed +3.6% per loop (absorbed the old horde_speed bonus)
loop_boss_hp      = 2.25   # boss hp (body and parts) x2.25 per loop (compounding; was a flat
                           # +100%/loop PLUS a separate per-build horde bonus -- merged into one
                           # compounding rate landing near the old combined curve for loop 1-2)
boss_hp_mul       = 2.0    # GLOBAL boss hp multiplier (body, parts, worm segments) â€” bosses
                           # were melting against even capped builds ("just double every
                           # bosses health, at least")
elite_xp_per_loop = 0.25   # ...and +25% xp reward, so tougher loops are worth actually fighting for

[director]
# Wave cadence + field crowding. A wave arrives, you clear it, then a LULL (calm) before the
# next â€” so combat has rhythm, not a relentless stream (lull logic lives in spawn.c). Field
# crowding ramps with stage (per_stage) to carry late difficulty; the base stays gentle.
field_cap_base      = 32    # gentle opening swarm (fresh level-1 ship); ramp carries late crowding
field_cap_per_stage = 35    # the ramp does the late-game crowding instead
field_cap_max       = 600   # 400 -> 600: let the late-game field actually saturate the screen
wave_interval_base  = 9.0     # 12 -> 9: waves arrive a bit faster, so the field refills / pressures
wave_interval_min_sub = 3.0   # 2 -> 3: late stages shave more off the interval (relentless late)
boss_grace_seconds  = 8.0     # summon the boss even if a few stragglers linger
waves_per_stage_base = 8      # + stage after each boss (was 4 -> bosses are a longer goal)

[boss]
hp_base      = 400.0   # + stage * hp_per_stage
hp_per_stage = 350.0
radius       = 46.0

[xp]
# Steep level curve so cards/power are earned, not handed out. With bosses no longer dumping
# ~400 XP + a free level, this paces ~L7 entering stage 3 (was L11-12).
# cumulative XP to reach: L5 ~1000, L10 ~9600, L15 ~37600, L20 ~100000.
base     = 9.0     # lower base = early levels arrive sooner -> build comes online before the
                   # stage-2 swarm overwhelms a fresh ship (fixes the early death cluster)
exponent = 2.5     # was 1.9, then 2.3: players STILL hit runaway strength by boss 2-3, on top
                   # of the rune-pity removal above. Base untouched (L1-4 cost is near-identical),
                   # but each level from ~L8 on costs noticeably more, so the mid-game snowball
                   # has to be earned over more stages instead of tipping over right after boss 2
# 01_void - the starting biome. A biome is a folder: this metadata + an enemies/ folder.
name = "The Void"

[theme]
bullet_color = "pinkred"
gem_color = "gold"
background = "black"
star_colors = ["navy", "indigo", "periwinkle"]

[director]
field_cap_base = 60
field_cap_per_stage = 20
field_cap_max = 400
wave_interval_base = 12.0
waves_to_boss = 9
formations = ["row", "vee", "stream", "grid", "swarm"]

[boss]
name = "Null Maw"
weapon = "ion"          # boss yield: the null beam
sprite="sprites/01_void/boss.png"
hp = 600
radius = 46
phases = [
  { hp_above = 0.66, fire = "aimed", count = 5 },
  { hp_above = 0.33, fire = "aimed", count = 7, plus = "flower" },
  { hp_above = 0.0,  fire = "aimed", count = 10, plus = "flower" },
]
# Grunt
name="Riftmite"
sprite="sprites/01_void/riftmite.png"
flavor="Chittering vanguard of the rift; marches in lockstep and dies in droves."
move="march"
move_params={ step_mul=1.0, edge_margin=40, row_drop=26, settle_speed=6 }
fire="none"
hp=6
speed=26
radius=11
fire_interval=0.0
min_stage=1
color="seagreen"
xp=1
shape=[{op="rect",w=2.0,h=2.0,color="body",outline="white"},{op="circle",r=0.35,color="white",alpha=0.5}]
